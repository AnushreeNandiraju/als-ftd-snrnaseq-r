top10 <- head(VariableFeatures(snrnaseqdata), 10)
plot1 <- VariableFeaturePlot(snrnaseqdata)
plot2 <- LabelPoints(plot = plot1, points = top10, repel = TRUE)
plot1 + plot2

snrnaseqdata <- RunPCA(snrnaseqdata, features = VariableFeatures(object = snrnaseqdata))





