snrnaseq.data <- readRDS("snRNA_SeuratV4_object_for_manuscript.rds")

cols.to.remove <- c("seurat_clusters", "annotation_cell_class", "annotation_major_cell_type", "annotation_cell_subtype")
for (col in cols.to.remove) {
  snrnaseq.data[[col]] <- NULL
}

snrnaseq.data[["percent.mt"]] <- PercentageFeatureSet(snrnaseqdata, pattern = "^MT-")
VlnPlot(snrnaseqdata, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
plot1 <- FeatureScatter(snrnaseqdata, feature1 = "nCount_RNA", feature2 = "percent.mt")
plot2 <- FeatureScatter(snrnaseqdata, feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
plot1 + plot2


snrnaseqdata <- subset(snrnaseqdata, subset = nFeature_RNA > 500 & nFeature_RNA < 2500 & percent.mt < 20)

# store mitochondrial percentage in object meta data
snrnaseqdata <- PercentageFeatureSet(snrnaseqdata, pattern = "^MT-", col.name = "percent.mt")

# run sctransform
snrnaseqdata <- SCTransform(snrnaseqdata, vars.to.regress = "percent.mt", verbose = FALSE)

