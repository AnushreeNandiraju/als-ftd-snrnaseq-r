## Define major cell types (from your table)
cell_types <- c(
  "Astro", "Endo",
  "Exc_deep", "Exc_intermediate", "Exc_upper",
  "Inh_LAMP5", "Inh_other_CGE", "Inh_PVALB", "Inh_SST", "Inh_VIP",
  "Micro", "Oligo", "OPC", "VLMC"
)

## Disease comparison pairs
cond_pairs <- list(
  c("C9-FTD", "Control"),
  c("C9-FTD", "C9-ALS"),
  c("C9-ALS", "Control")
)

for (celltype in cell_types) {
  
  # Subset Seurat object for each major cell type
  celltype_obj <- subset(data, subset = annotation_major_cell_type == celltype)
  
  # Skip if not enough cells
  if (ncol(celltype_obj) < 10) next
  
  # Set disease as the identity
  Idents(celltype_obj) <- celltype_obj$disease
  
  for (pair in cond_pairs) {
    ident1 <- pair[1]
    ident2 <- pair[2]
    
    # Skip if one of the conditions is missing
    if (!(ident1 %in% levels(Idents(celltype_obj)) &&
          ident2 %in% levels(Idents(celltype_obj)))) {
      next
    }
    
    message("Single-cell DE: ", celltype, " | ", ident1, " vs ", ident2)
    
    result_sc <- FindMarkers(
      celltype_obj,
      ident.1 = ident1,
      ident.2 = ident2,
      test.use = "wilcox"
    )
    
    fn_sc <- paste0(
      "DEG_sc_",
      gsub(" ", "", celltype),
      "_", ident1, "_vs_", ident2, ".csv"
    )
    # write.csv(result_sc, file = fn_sc, row.names = TRUE)
  }
}


# Remove cells without subject ID
data$subject[is.na(data$subject)] <- "unknown"
data <- subset(data, subset = subject != "unknown")

# Optional combined label
data$dis_subject_celltype <- paste(
  data$disease,
  data$subject,
  data$annotation_major_cell_type,
  sep = "_"
)

# AggregateExpression to build pseudobulk
pseudo <- AggregateExpression(
  data,
  assays = "RNA",
  return.seurat = TRUE,
  group.by = c("disease", "subject", "annotation_major_cell_type")
)

# Create celltype_disease identity in pseudobulk object
pseudo$celltype_disease <- paste(
  pseudo$annotation_major_cell_type,
  pseudo$disease,
  sep = "_"
)

Idents(pseudo) <- "celltype_disease"


for (celltype in cell_types) {
  for (pair in cond_pairs) {
    ident1 <- paste0(celltype, "_", pair[1])  # e.g. "Exc_upper_C9-FTD"
    ident2 <- paste0(celltype, "_", pair[2])  # e.g. "Exc_upper_Control"
    
    if (!(ident1 %in% levels(Idents(pseudo)) &&
          ident2 %in% levels(Idents(pseudo)))) {
      next
    }
    
    message("Pseudobulk DE: ", celltype, " | ", pair[1], " vs ", pair[2])
    
    res_bulk <- FindMarkers(
      object   = pseudo,
      ident.1  = ident1,
      ident.2  = ident2,
      test.use = "DESeq2",
      assay    = "RNA"
    )
    
    fn_bulk <- paste0(
      "DEG_bulk_",
      gsub(" ", "", celltype),
      "_", pair[1], "_vs_", pair[2], ".csv"
    )
    write.csv(res_bulk, file = fn_bulk, row.names = TRUE)
  }
}


# Choose one of your actual labels, e.g. Exc_upper
celltype_of_interest <- "Exc_upper"
contrast_pair <- c("C9-FTD", "Control")

## Single-cell DE for that cell type and contrast
celltype_obj <- subset(data, subset = annotation_major_cell_type == celltype_of_interest)
Idents(celltype_obj) <- celltype_obj$disease

sc_res <- FindMarkers(
  celltype_obj,
  ident.1  = contrast_pair[1],
  ident.2  = contrast_pair[2],
  test.use = "wilcox"
)

## Pseudobulk DE for the same cell type and contrast
Idents(pseudo) <- "celltype_disease"
ident1_pb <- paste0(celltype_of_interest, "_", contrast_pair[1])
ident2_pb <- paste0(celltype_of_interest, "_", contrast_pair[2])

bulk_res <- FindMarkers(
  pseudo,
  ident.1  = ident1_pb,
  ident.2  = ident2_pb,
  test.use = "DESeq2",
  assay    = "RNA"
)


names(bulk_res) <- paste0(names(bulk_res), ".bulk")
bulk_res$gene <- rownames(bulk_res)

names(sc_res) <- paste0(names(sc_res), ".sc")
sc_res$gene <- rownames(sc_res)

merge_dat <- merge(sc_res, bulk_res, by = "gene")
merge_dat <- merge_dat[order(merge_dat$p_val.bulk), ]

common    <- merge_dat$gene[merge_dat$p_val.bulk < 0.05 & merge_dat$p_val.sc < 0.05]
only_sc   <- merge_dat$gene[merge_dat$p_val.bulk >= 0.05 & merge_dat$p_val.sc < 0.05]
only_bulk <- merge_dat$gene[merge_dat$p_val.bulk < 0.05 & merge_dat$p_val.sc >= 0.05]

cat("# Common: ", length(common), "\n")
cat("# Only in single-cell: ", length(only_sc), "\n")
cat("# Only in bulk: ", length(only_bulk), "\n")



# Add subject_disease to single-cell object for per-sample violins
data$subject_disease <- paste0(data$disease, "-", data$subject)
Idents(data) <- "disease"

# Top 2 common genes
if (length(common) >= 2) {
  top_common <- common[1:2]
  print(merge_dat[merge_dat$gene %in% top_common,
                  c("gene", "p_val.sc", "p_val.bulk")])
  
  VlnPlot(
    data,
    features = top_common,
    idents   = contrast_pair,
    group.by = "disease",
    ncol     = 1
  )
  
  VlnPlot(
    data,
    features = top_common,
    idents   = contrast_pair,
    group.by = "subject_disease",
    ncol     = 1
  )
}

# Top 2 genes only significant in single-cell
if (length(only_sc) >= 2) {
  top_only_sc <- only_sc[1:2]
  print(merge_dat[merge_dat$gene %in% top_only_sc,
                  c("gene", "p_val.sc", "p_val.bulk")])
  
  VlnPlot(
    data,
    features = top_only_sc,
    idents   = contrast_pair,
    group.by = "disease",
    ncol     = 1
  )
  
  VlnPlot(
    data,
    features = top_only_sc,
    idents   = contrast_pair,
    group.by = "subject_disease",
    ncol     = 1
  )
}

