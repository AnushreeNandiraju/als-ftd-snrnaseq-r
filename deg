library(Seurat)
library(SeuratData)
library(dplyr)
library(DESeq2)


data <- readRDS("C:/Users/famna/Downloads/snRNA_SeuratV4_fulldata/snRNA_SeuratV4_object_for_manuscript.rds")



## Define major cell types 
cell_types <- c(
  "Astro", "Endo",
  "Exc_deep", "Exc_intermediate", "Exc_upper",
  "Inh_LAMP5", "Inh_other_CGE", "Inh_PVALB", "Inh_SST", "Inh_VIP",
  "Micro", "Oligo", "OPC", "VLMC"
)

## Disease comparison pairs
cond_pairs <- list(
  c("C9-FTD", "Control"),
  c("C9-FTD", "C9-ALS"),
  c("C9-ALS", "Control")
)

for (celltype in cell_types) {
  
  # Subset Seurat object for each major cell type
  celltype_obj <- subset(data, subset = annotation_major_cell_type == celltype)
  
  # Skip if not enough cells
  if (ncol(celltype_obj) < 10) next
  
  # Set disease as the identity
  Idents(celltype_obj) <- celltype_obj$disease
  
  for (pair in cond_pairs) {
    ident1 <- pair[1]
    ident2 <- pair[2]
    
    # Skip if one of the conditions is missing
    if (!(ident1 %in% levels(Idents(celltype_obj)) &&
          ident2 %in% levels(Idents(celltype_obj)))) {
      next
    }
    
    message("Single-cell DE: ", celltype, " | ", ident1, " vs ", ident2)
    
    result_sc <- FindMarkers(
      celltype_obj,
      ident.1 = ident1,
      ident.2 = ident2,
      test.use = "wilcox"
    )
    
    fn_sc <- paste0(
      "DEG_sc_",
      gsub(" ", "", celltype),
      "_", ident1, "_vs_", ident2, ".csv"
    )
    # write.csv(result_sc, file = fn_sc, row.names = TRUE)
  }
}


