broadannotation <- readRDS("C:/Users/famna/OneDrive/Documents/broadannotation.rds")

library(Seurat)

DimPlot(broadannotation, reduction = "umap", group.by = "predicted.id", label = TRUE)
reference <- FindVariableFeatures(reference)
data <- FindVariableFeatures(broadannotation)

common.features <- intersect(VariableFeatures(reference), VariableFeatures(broadannotation))

# Normalize RNA assay data
reference <- NormalizeData(reference)

# Find variable features
reference <- FindVariableFeatures(reference)

# Scale data
reference <- ScaleData(reference)

# Run PCA on scaled data
reference <- RunPCA(reference)

# Repeat the same for your query object
data <- NormalizeData(broadannotation)
data <- FindVariableFeatures(broadannotation)
data <- ScaleData(broadannotation)
data <- RunPCA(broadannotation)

anchors <- FindTransferAnchors(
  reference = reference,
  query = data,
  normalization.method = "LogNormalize",
  reference.assay = "RNA",
  query.assay = "RNA",
  features = common.features,  # Make sure you defined this as shared variable features
  dims = 1:30
)

predicted.labels <- TransferData(
  anchorset = anchors,
  refdata = reference$cluster_label,
  dims = 1:30
)

# Add new metadata column without replacing existing "predicted.id"
broadannotation[["specific_labels"]] <- predicted.labels$predicted.id

Idents(data) <- "seurat_clusters"
clusters <- as.numeric(as.character(Idents(data)))  # Get cluster identities

fine_type <- rep(NA, length(clusters))

# Assign fine cell types per list:
fine_type[clusters %in% c(13, 14, 7, 5, 9, 1, 0, 6, 4,15)]       <- "Oligo"
fine_type[clusters %in% c(11, 2, 20)]                         <- "Astro"
fine_type[clusters %in% c(10)]                                <- "Micro"
fine_type[clusters %in% c(8)]                                 <- "OPC"
fine_type[clusters %in% c(26, 23)]                            <- "VLMC"
fine_type[clusters %in% c(14)]                                <- "Inh_VIP"
# If you have specific cluster numbers for Inh-other_CGE, fill in here:
# fine_type[clusters %in% c()]                                <- "Inh-other_CGE"
fine_type[clusters %in% c(22)]                                <- "Inh_Lamp5"
fine_type[clusters %in% c(17, 27)]                            <- "Inh_PVALB"
fine_type[clusters %in% c(16)]                                <- "Inh_SST"
fine_type[clusters %in% c(3)]                                 <- "Exc_upper"
fine_type[clusters %in% c(18, 28, 24, 19,25)]                    <- "Exc_deep"
fine_type[clusters %in% c(12)]                                <- "Exc_intermediate"
fine_type[clusters %in% c(21)]                                <- "Endo"

# Add the fine cell type to metadata
data$fine_cell_type <- fine_type

# Inspect the metadata
head(data@meta.data) # Both manual_cell_type and fine_cell_type will be columns


# Now you have both "predicted.id" and "specific_labels" in your metadata
DimPlot(data, reduction = "umap", group.by = "fine_cell_type", label = TRUE)

broadannotation[["simple_annotation"]] <- NULL

saveRDS(data,file="specificannotation.rds",compress = FALSE)
